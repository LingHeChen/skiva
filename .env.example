SKIVA_ENV=local
SKIVA_DATABASE_URL=postgres://skiva:skiva-dev@localhost:55432/skiva?sslmode=disable
SKIVA_ADMIN_EMAIL=admin@localhost
SKIVA_ADMIN_PASSWORD=replace-with-a-unique-long-password
SKIVA_LISTEN=127.0.0.1:8080
SKIVA_WEB_ORIGIN=http://localhost:3000
SKIVA_DATA_DIR=.data
SKIVA_GIT_ALLOWLIST=
SKIVA_VALIDATOR_VERSION=1
# HTTPS credential secret contents: "Bearer <token>" or "Basic <base64 user:token>"
# SKIVA_GIT_TOKEN=
# SKIVA_WEBHOOK_SECRET=
# SKIVA_GIT_CA_BUNDLE=/run/secrets/git-ca.pem
# SKIVA_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
# SKIVA_OIDC_ISSUER=https://idp.example.com/realms/enterprise
# SKIVA_OIDC_CLIENT_ID=skiva
# SKIVA_OIDC_CLIENT_SECRET=
