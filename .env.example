ESDP_ENV=local
ESDP_DATABASE_URL=postgres://esdp:esdp-dev@localhost:55432/esdp?sslmode=disable
ESDP_ADMIN_EMAIL=admin@localhost
ESDP_ADMIN_PASSWORD=replace-with-a-unique-long-password
ESDP_LISTEN=127.0.0.1:8080
ESDP_WEB_ORIGIN=http://localhost:3000
ESDP_DATA_DIR=.data
ESDP_GIT_ALLOWLIST=
ESDP_VALIDATOR_VERSION=1
# HTTPS credential secret contents: "Bearer <token>" or "Basic <base64 user:token>"
# ESDP_GIT_TOKEN=
# ESDP_WEBHOOK_SECRET=
# ESDP_GIT_CA_BUNDLE=/run/secrets/git-ca.pem
# ESDP_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
# ESDP_OIDC_ISSUER=https://idp.example.com/realms/enterprise
# ESDP_OIDC_CLIENT_ID=esdp
# ESDP_OIDC_CLIENT_SECRET=
